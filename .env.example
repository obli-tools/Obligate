# ── Image version (tag Docker Hub, ex: latest, 0.1.0) ──
OBLIGATE_VERSION=latest

# ── Database ──
# If using the built-in postgres container (docker-compose.yml):
DB_PASSWORD=changeme

# If using an external PostgreSQL (docker-compose.external-db.yml):
# DATABASE_URL=postgres://obligate:yourpassword@your-db-host:5432/obligate

# ── Server ──
SESSION_SECRET=change-this-to-a-random-secret

# ── Client origin (for CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost
LISTEN_PORT=3020

# ── Default admin (created on first run) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── SSO hardening ──
# Extra origins /authorize may send an app's code to, besides the origin of its
# registered base URL (and loopback for the desktop flow). Escape hatch when
# users reach an app through another address: prefer fixing the base URL.
# Format: <appId>=<origin>[,<origin>...][;<appId>=...]  (appId is logged on refusal)
# OAUTH_EXTRA_REDIRECT_ORIGINS=
# App types allowed to receive a code on a loopback redirect_uri (desktop /
# native flow). Default: obliance (Oblireach desktop client). '*' = all, 'none' = off.
# OAUTH_LOOPBACK_APP_TYPES=obliance
# true = delegation tokens may name a platform admin (god view on the audience
# app). Keep off until every app sends its public client_id and keys are rotated.
# GOES WITH Obliance's OBLIGATE_DELEGATION_ALLOW_ADMIN: if an Obliance runs with
# OBLIGATE_DELEGATION_ALLOW_ADMIN=true (admins see the Oblidesk context rail),
# this must be true as well — otherwise every mint for an admin is refused here
# (403 subject_admin_refused) and the rail shows "not_authorised" for admins.
# DELEGATION_ALLOW_ADMIN_SUBJECTS=
# App-scoped delegation tokens (sub = app:<requester>, no user named) are
# DENIED unless the (requester:audience) pair is listed here. Example: Oblihub's
# honeypot bans pushed to Obliguard need "oblihub:obliguard".
# DELEGATION_APP_SUBJECT_PAIRS=
# An app whose RAW API key was seen as a client_id (it went through browsers)
# mints no delegation token until its key is rotated (Connected Apps page).
# true = override while an app is being migrated (knowingly: that key is public).
# DELEGATION_ALLOW_EXPOSED_KEYS=
# Raw API key accepted as client_id on /authorize (legacy form, each use is
# recorded and flags the key as exposed): '*' (default) = every app, 'none' =
# no app, or the app types still sending it, e.g. "oblidesk,oblifield".
# OAUTH_ACCEPT_RAW_CLIENT_ID=
# App types that can be given an inbound secret (they require it from Obligate
# instead of their API key). Default: obliance,oblimap,oblihub. Any other app
# only accepts its API key: an inbound secret would cut Obligate off from it.
# INBOUND_SECRET_APP_TYPES=
# Step-up support of the apps for SSO accounts (TOTP anti-replay, MFA epoch,
# credentials-changed pushes, prompt=login). false = GET /api/oauth/capabilities
# stops announcing it (the apps then keep SSO accounts off their phone keys).
# OAUTH_LOT_O_CAPABILITIES=

# ── Encryption key for LDAP bind passwords (32 bytes hex) ──
# Also seals the delegation signing key and the per-app inbound secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=
